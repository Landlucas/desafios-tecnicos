{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": [
    {
      "path": "./lint/board-no-browser-globals.grit",
      "includes": ["src/board.ts"]
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  }
}
